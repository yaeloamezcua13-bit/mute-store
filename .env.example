# ==========================================================================
# Configuración de la tienda MUTE — copia este archivo como .env y rellénalo
# ==========================================================================

# --- General ---
SECRET_KEY=pon-aqui-una-llave-larga-y-secreta
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# --- Base de datos ---
# Por defecto usa SQLite (no necesitas configurar nada).
# Para PostgreSQL (producción/enterprise) descomenta y ajusta:
# DATABASE_URL=postgres://usuario:contrasena@localhost:5432/mute

# --- Tienda ---
STORE_PHONE=9988416700
STORE_INSTAGRAM=mut3.mx
STORE_EMAIL=hola@mute.mx
IVA_RATE=0.16
FREE_SHIPPING_COUNTRY=MX
INTERNATIONAL_SHIPPING_COST=300

# --- Pagos: Stripe ---
# Llaves de prueba en https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Pagos: MercadoPago ---
# Credenciales en https://www.mercadopago.com.mx/developers/panel/app
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# --- Imágenes IA (nano banana / Gemini) ---
# Llave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Correo (confirmaciones de pedido) ---
# Por defecto se imprime en consola. Para enviar de verdad, configura SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tucorreo@gmail.com
# EMAIL_HOST_PASSWORD=tu-app-password
# DEFAULT_FROM_EMAIL=MUTE <hola@mute.mx>
